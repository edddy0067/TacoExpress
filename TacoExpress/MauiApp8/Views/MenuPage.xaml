<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiApp8.Views.MenuPage"
    x:Name="MenuPageRoot"
    Title="Menú">

    <Grid
        Padding="20"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="10">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="5"
            Margin="0,0,0,15">

            <Label
                Text="TacoExpress"
                FontSize="28"
                FontAttributes="Bold"/>

            <Label
                Text="Selecciona los productos para tu pedido"
                FontSize="16"/>

        </VerticalStackLayout>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Productos}">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        StrokeThickness="1"
                        Padding="15"
                        Margin="0,5">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto,Auto">

                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{Binding Nombre}"
                                FontSize="20"
                                FontAttributes="Bold"/>

                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="{Binding Descripcion}"
                                FontSize="14"/>

                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="{Binding Precio, StringFormat='${0:F2}'}"
                                FontSize="18"
                                FontAttributes="Bold"/>

                            <Button
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                Grid.Column="1"
                                Text="Agregar"
                                VerticalOptions="Center"
                                Command="{Binding BindingContext.AgregarAlCarritoCommand,
                                          Source={x:Reference MenuPageRoot}}"
                                CommandParameter="{Binding .}"/>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button
            Grid.Row="2"
            Text="Ver carrito"
            Margin="0,15,0,0"
            Clicked="OnVerCarritoClicked"/>

    </Grid>

</ContentPage>